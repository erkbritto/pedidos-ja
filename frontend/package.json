{
  "name": "pedido-ja-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pedido Já — frontend SPA (React + TypeScript + Vite) para a API FastAPI de gerenciamento de pedidos.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
