# Este arquivo é apenas documentação/referência. `docker compose up -d --build`
# funciona mesmo sem copiar este arquivo para `.env` — o docker-compose.yml
# já define defaults de laboratório equivalentes a estes valores.

POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos

# Hostname `postgres` só existe dentro da rede do Docker Compose (nome do
# serviço). Fora do Compose (ex.: rodando a API localmente com `uvicorn`
# durante o desenvolvimento), troque `postgres` por `localhost`.
DATABASE_URL=postgresql+psycopg://pedidos:pedidos@postgres:5432/pedidos

# Origem extra liberada para CORS quando o frontend roda separadamente em
# desenvolvimento (`npm run dev`, porta 5173). Em produção same-origin isso
# não é exercitado pelo navegador.
CORS_ORIGINS=http://localhost:5173
